{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://hiderbuildings-backend.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://hiderbuildings-backend.onrender.com/uploads/$1"
    },
    {
      "source": "/img/(.*)",
      "destination": "https://hiderbuildings-backend.onrender.com/img/$1"
    },
    {
      "source": "/vtour/(.*)",
      "destination": "https://hiderbuildings-backend.onrender.com/vtour/$1"
    },
    {
      "source": "/j_spring_security_check",
      "destination": "https://hiderbuildings-backend.onrender.com/j_spring_security_check"
    },
    {
      "source": "/login",
      "destination": "https://hiderbuildings-backend.onrender.com/login"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
